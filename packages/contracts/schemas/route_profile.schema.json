{
  "$id": "route_profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target_id",
    "method",
    "route_template",
    "location",
    "name",
    "sample_count",
    "train_count",
    "holdout_count",
    "type_distribution",
    "dominant_type",
    "length",
    "charset",
    "entropy",
    "required_ratio",
    "discriminative",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "method": {
      "type": "string"
    },
    "route_template": {
      "type": "string"
    },
    "location": {
      "enum": [
        "query",
        "body_form",
        "body_json",
        "header",
        "cookie",
        "path"
      ]
    },
    "name": {
      "type": "string"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "train_count": {
      "type": "integer",
      "minimum": 0
    },
    "holdout_count": {
      "type": "integer",
      "minimum": 0
    },
    "type_distribution": {
      "type": "object"
    },
    "dominant_type": {
      "type": "string"
    },
    "length": {
      "type": "object",
      "properties": {
        "min": { "type": "integer" },
        "p50": { "type": "number" },
        "p99": { "type": "number" },
        "max": { "type": "integer" }
      }
    },
    "charset": {
      "type": "object",
      "properties": {
        "classes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "extra": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "entropy": {
      "type": "object",
      "properties": {
        "mean": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "required_ratio": {
      "type": "number"
    },
    "discriminative": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
