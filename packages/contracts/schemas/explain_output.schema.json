{
  "$id": "explain_output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "why_it_matters",
    "attacker_path",
    "recommended_action",
    "confidence"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 280
    },
    "why_it_matters": {
      "type": "string",
      "maxLength": 280
    },
    "attacker_path": {
      "type": "string",
      "maxLength": 280
    },
    "recommended_action": {
      "type": "string",
      "maxLength": 280
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    }
  }
}
